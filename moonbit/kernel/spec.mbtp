/// Law of limitation for a written accent at syllable `pos` (1 = ultima) of an `nsyl`-syllable word.
// NOTE: the proof frontend drops parentheses around a disjunction that is an operand of &&
// (A && (B || C) is read as A && B || C). Every disjunction therefore lives in its own predicate,
// and predicates combine them with && only.
predicate lol_antepenult(pos : Int, ult_long : Bool) { (pos != 3) || (ult_long == false) }
predicate lol_circ_pos(pos : Int, circ : Bool) { (circ == false) || (pos <= 2) }
predicate lol_circ_long(circ : Bool, nuc_long : Bool) { (circ == false) || (nuc_long == true) }
predicate lol_circ_penult(pos : Int, circ : Bool, ult_long : Bool) { (circ == false) || (pos != 2) || (ult_long == false) }
predicate law_of_limitation(nsyl : Int, pos : Int, circ : Bool, nuc_long : Bool, ult_long : Bool) {
  (1 <= pos) && (pos <= nsyl) && (pos <= 3) &&
  lol_antepenult(pos, ult_long) && lol_circ_pos(pos, circ) &&
  lol_circ_long(circ, nuc_long) && lol_circ_penult(pos, circ, ult_long)
}

/// Recessive accent position (1 = ultima), logic side.
fn rpos_spec(nsyl : Int, ult_long : Bool) -> Int {
  if nsyl <= 1 {
    1
  } else {
    if ult_long || (nsyl == 2) {
      2
    } else {
      3
    }
  }
}

/// kinds[i] == 1 marks a vowel nucleus unit, 0 a consonant unit.
predicate consonant_gap(kinds : FixedArray[Int], a : Int, b : Int) {
  ∀ i : Int, (i <= a) || (b <= i) || (kinds[i] == 0)
}

/// Units [lo, hi) contain exactly one nucleus, at index a.
predicate one_nucleus(kinds : FixedArray[Int], lo : Int, hi : Int, a : Int) {
  (lo <= a) && (a < hi) && (kinds[a] == 1) &&
  (∀ i : Int, (i < lo) || (hi <= i) || (i == a) || (kinds[i] == 0))
}

/// Middle syllable: cut points cp (start) and c (end) around nucleus a, between nuclei p < a < b.
lemma middle_syllable_one_nucleus(kinds : FixedArray[Int], p : Int, a : Int, b : Int, cp : Int, c : Int) where {
  proof_require: 0 <= p,
  proof_require: p < a,
  proof_require: a < b,
  proof_require: b < kinds.length(),
  proof_require: kinds[a] == 1,
  proof_require: consonant_gap(kinds, p, a),
  proof_require: consonant_gap(kinds, a, b),
  proof_require: p < cp,
  proof_require: cp <= a,
  proof_require: a < c,
  proof_require: c <= b,
  proof_ensure: one_nucleus(kinds, cp, c, a),
} {}

/// Consecutive cuts are strictly increasing, so syllables partition the word (concat == word).
lemma cuts_strictly_increase(p : Int, a : Int, b : Int, c1 : Int, c2 : Int) where {
  proof_require: p < a,
  proof_require: a < b,
  proof_require: p < c1,
  proof_require: c1 <= a,
  proof_require: a < c2,
  proof_require: c2 <= b,
  proof_ensure: c1 < c2,
} {}


/// Accent marks written by a phrase decision code (logic side).
fn accents_spec(code : Int, lex_pos : Int) -> Int {
  if code == 0 { 0 } else { if code == 1 { if lex_pos > 0 { 1 } else { 0 } } else { if code == 4 { 2 } else { 1 } } }
}

/// Accent position read back by lexical_phrase from a decision code (logic side).
fn decoded_spec(code : Int, lex_pos : Int) -> Int {
  if code == 1 || code == 4 { lex_pos } else { if code == 0 { 0 } else { 1 } }
}

/// Phone ids (see lib/g2p_tables.mbt): 1 a 2 e 3 i 4 o 5 u 6 y 7 ɛ 8 ɛː 9 ɔː 10 eː 11 oː 12 ɪ 13 ʊ 14 ɔ
/// 15 w 16 j 17 h 18 f 19 v 20 β 21 b 22 d 23 g 24 m 25 n 26 ŋ 27 ʝ 28 ɣ 29 ç 30 x 31 z 32 ð 33 θ
/// 34 k 35 s 36 p 37 l 38 r 39 t 40 d͡z 41 tʰ 42 pʰ 43 kʰ 44 uː 45 aː 46 iː 47 yː.
predicate common_inv(id : Int) {
  id == 1 || id == 3 || id == 4 || id == 34 || id == 35 || id == 36 || id == 37 || id == 24 || id == 25 || id == 38 || id == 39 || id == 26
}
predicate modern_inv(id : Int) {
  common_inv(id) || id == 2 || id == 5 || id == 18 || id == 19 || id == 21 || id == 22 || id == 23 ||
  id == 27 || id == 28 || id == 29 || id == 30 || id == 31 || id == 32 || id == 33
}
predicate koine_extra(id : Int) {
  id == 7 || id == 2 || id == 6 || id == 5 || id == 18 || id == 20 || id == 27 ||
  id == 28 || id == 19 || id == 32 || id == 31 || id == 41 || id == 42 || id == 43
}
predicate attic_extra(id : Int) {
  id == 2 || id == 8 || id == 6 || id == 9 || id == 10 || id == 11 || id == 5 ||
  id == 17 || id == 23 || id == 21 || id == 22 || id == 31 || id == 41 || id == 42 || id == 43 ||
  id == 44 || id == 45 || id == 46 || id == 47
}
predicate erasmian_extra(id : Int) {
  id == 2 || id == 12 || id == 5 || id == 13 || id == 14 || id == 15 || id == 16 ||
  id == 17 || id == 23 || id == 40 || id == 33 || id == 18 || id == 21 || id == 22 || id == 30
}
predicate inv0(id : Int) { modern_inv(id) }
predicate inv1(id : Int) { common_inv(id) || koine_extra(id) }
predicate inv2(id : Int) { common_inv(id) || attic_extra(id) }
predicate inv3(id : Int) { common_inv(id) || erasmian_extra(id) }
predicate if0(s : Int, id : Int) { (s != 0) || inv0(id) }
predicate if1(s : Int, id : Int) { (s != 1) || inv1(id) }
predicate if2(s : Int, id : Int) { (s != 2) || inv2(id) }
predicate if3(s : Int, id : Int) { (s != 3) || inv3(id) }
/// Phone id belongs to scheme s's inventory (0 modern, 1 koine, 2 attic, 3 erasmian).
predicate in_inv(s : Int, id : Int) {
  (0 <= s) && (s <= 3) && if0(s, id) && if1(s, id) && if2(s, id) && if3(s, id)
}
predicate slot_ok(s : Int, p : Int) { (p == 0) || in_inv(s, p) }
/// αυ / ευ / ηυ (alpha, epsilon or eta + upsilon).
predicate au_eu_hu(a : Int, b : Int) {
  (b == 965) && ((a == 945) || (a == 949) || (a == 951))
}
/// Koine word-final αυ/ευ/ηυ ends in v (phone 19), not β and not f.
predicate koine_word_final_v(s : Int, n : Int, i : Int, a : Int, b : Int, q : Int) {
  (s != 1) || ((i + 2) < n) || (au_eu_hu(a, b) == false) || (((q / 64) % 64) == 19)
}
/// A packed phone sequence p1 + 64*p2 + 4096*p3 (0 = no phone) uses only scheme s's phones.
predicate seq_ok(s : Int, q : Int) {
  (0 <= q) && (q < 262144) && slot_ok(s, q % 64) && slot_ok(s, (q / 64) % 64) && slot_ok(s, q / 4096)
}
/// out[0..k) are all phones of scheme s.
predicate all_in(s : Int, out : FixedArray[Int], k : Int) {
  ∀ j : Int, (j < 0) || (k <= j) || in_inv(s, out[j])
}

/// starts[0..k) are strictly increasing positions inside [0, n).
predicate in_word(x : Int, n : Int) { (0 <= x) && (x < n) }
predicate starts_ok(starts : FixedArray[Int], k : Int, n : Int) {
  ∀ j : Int, (j < 0) || (k <= j) || in_word(starts[j], n)
}

/// A contract() token: a Unicode scalar value, or one of the two spurious-diphthong markers
/// [ει] = 0x110000 and [ου] = 0x110001 (outside Unicode, so they can't collide with input).
predicate valid_tok(t : Int) { (0 <= t) && (t <= 1114113) }
predicate all_valid(xs : FixedArray[Int], k : Int) {
  ∀ j : Int, (j < 0) || (k <= j) || valid_tok(xs[j])
}

/// Accent rendering on a word as slots (one per base letter): marks[k] is 0 none, 1 acute,
/// 2 grave, 3 circumflex; syl[k] is the syllable of slot k counted from the end (1 = ultima);
/// vow[k] is 1 for a vowel letter.
predicate is_target(syl : FixedArray[Int], vow : FixedArray[Int], pos : Int, k : Int) {
  (syl[k] == pos) && (vow[k] == 1)
}
predicate not_target_after(syl : FixedArray[Int], vow : FixedArray[Int], pos : Int, r : Int, n : Int) {
  ∀ j : Int, (j <= r) || (n <= j) || (syl[j] != pos) || (vow[j] != 1)
}
predicate found_ok(syl : FixedArray[Int], vow : FixedArray[Int], pos : Int, r : Int, n : Int) {
  (r == -1) || ((0 <= r) && (r < n) && is_target(syl, vow, pos, r))
}
predicate same_except(a : FixedArray[Int], b : FixedArray[Int], u : Int, n : Int) {
  ∀ j : Int, (j < 0) || (n <= j) || (j == u) || (a[j] == b[j])
}
predicate zero_except(a : FixedArray[Int], u : Int, n : Int) {
  ∀ j : Int, (j < 0) || (n <= j) || (j == u) || (a[j] == 0)
}
predicate same_all(a : FixedArray[Int], b : FixedArray[Int], n : Int) {
  ∀ j : Int, (j < 0) || (n <= j) || (a[j] == b[j])
}
